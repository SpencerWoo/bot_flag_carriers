#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
version=v24.15.0
runtime="$PWD/.runtime/node"
if [[ -n "${FLAG_CARRIERS_NODE:-}" ]]; then
  node_bin="$FLAG_CARRIERS_NODE"
elif command -v node >/dev/null && node -e 'process.exit(Number(process.versions.node.split(".")[0])>=24?0:1)'; then
  node_bin="$(command -v node)"
elif [[ -x "$runtime/bin/node" ]]; then
  node_bin="$runtime/bin/node"
else
  case "$(uname -s)" in Linux) platform=linux;; Darwin) platform=darwin;; *) echo 'Install Node.js 24+ to continue.' >&2; exit 1;; esac
  case "$(uname -m)" in x86_64) arch=x64;; aarch64|arm64) arch=arm64;; *) echo 'Install Node.js 24+ for this architecture.' >&2; exit 1;; esac
  mkdir -p .runtime
  chmod 700 .runtime
  archive="node-$version-$platform-$arch.tar.gz"
  curl --proto '=https' --tlsv1.2 -fsSL "https://nodejs.org/dist/$version/$archive" -o ".runtime/$archive"
  expected="$(curl --proto '=https' --tlsv1.2 -fsSL "https://nodejs.org/dist/$version/SHASUMS256.txt" | awk -v file="$archive" '$2==file {print $1}')"
  if command -v sha256sum >/dev/null; then actual="$(sha256sum ".runtime/$archive" | awk '{print $1}')"; else actual="$(shasum -a 256 ".runtime/$archive" | awk '{print $1}')"; fi
  [[ -n "$expected" && "$actual" == "$expected" ]] || { echo 'Node.js checksum verification failed' >&2; exit 1; }
  mkdir -p "$runtime"
  tar -xzf ".runtime/$archive" -C "$runtime" --strip-components=1
  rm ".runtime/$archive"
  node_bin="$runtime/bin/node"
fi
export PATH="$(dirname "$node_bin"):$PATH"
if [[ "${1:-}" == setup || ! -d node_modules ]]; then
  npm ci
  npm run build
  if [[ "${1:-}" == setup ]]; then exit 0; fi
fi
exec "$node_bin" --import tsx src/cli.ts "$@"
